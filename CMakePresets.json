{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "msvc-vs18-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "debug",
      "displayName": "vesta Debug (console)",
      "description": "Debug build with console and diagnostics",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "debug-local",
      "displayName": "vesta Debug (local VS 18)",
      "description": "Debug build with the local Visual Studio 18 generator; reuses build/debug",
      "inherits": "msvc-vs18-base",
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "release",
      "displayName": "vesta Release (clean)",
      "description": "Optimized release build without the console module",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "VESTA_PERF_LOG": "OFF",
        "VESTA_WINDOWED_PROFILE": "OFF",
        "VESTA_WINDOWED_SESSION": "OFF",
        "VESTA_OUTPUT_NAME": "vesta"
      }
    },
    {
      "name": "profile",
      "displayName": "vesta optimized CPU profiling",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/profile",
      "cacheVariables": {
        "VESTA_PERF_LOG": "ON",
        "VESTA_OUTPUT_NAME": "vesta-profile"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build vesta Debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "debug-local",
      "displayName": "Build vesta Debug (local VS 18)",
      "configurePreset": "debug-local",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Build vesta Release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "profile",
      "configurePreset": "profile",
      "configuration": "Release"
    }
  ]
}
